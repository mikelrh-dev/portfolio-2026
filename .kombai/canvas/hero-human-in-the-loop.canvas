      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500&display=swap');\n  .nm-mono { font-family: 'JetBrains Mono', monospace; }\n  .nm-sans { font-family: 'IBM Plex Sans', system-ui, sans-serif; }\n</style>\n\n<section id=\"nm-hero\" class=\"nm-sans relative overflow-hidden bg-[#000000] min-h-screen w-full flex flex-col px-[clamp(4rem,8vw,8rem)] py-[clamp(4rem,8vw,8rem)]\" data-kid=\"1\">\n\n  \n  <canvas id=\"nm-canvas\" class=\"absolute inset-0 w-full h-full z-0 pointer-events-none\" data-kid=\"2\"></canvas>\n\n  \n  <div class=\"absolute inset-0 z-0 pointer-events-none\" style=\"background-image:linear-gradient(#1A1A1A 1px,transparent 1px),linear-gradient(90deg,#1A1A1A 1px,transparent 1px);background-size:60px 60px;opacity:0.2;-webkit-mask-image:radial-gradient(ellipse 100% 70% at 50% 35%, #000 20%, transparent 90%);mask-image:radial-gradient(ellipse 100% 70% at 50% 35%, #000 20%, transparent 90%);\" data-kid=\"3\"></div>\n\n  \n  <div class=\"absolute z-0 pointer-events-none\" style=\"top:-18%;left:-8%;width:55vw;height:55vh;background:radial-gradient(ellipse at center, rgba(204,255,0,0.05) 0%, transparent 65%);\" data-kid=\"4\"></div>\n\n  \n  <div class=\"relative z-10 max-w-6xl mx-auto flex-1 w-full flex flex-col\" data-kid=\"5\">\n\n    \n    <div id=\"nm-indicator\" class=\"nm-mono self-start w-full mb-8 flex items-center gap-3 uppercase\" style=\"font-size:11px;color:#444444;letter-spacing:0.1em;font-weight:400;\" data-kid=\"6\">\n      <span data-kid=\"7\">01/04 — HERO</span>\n      <span class=\"flex-1 h-px\" style=\"background:linear-gradient(90deg,#222222 0%,transparent 100%);\" data-kid=\"8\"></span>\n    </div>\n\n    <div class=\"flex-1 flex flex-col justify-center max-w-4xl\" data-kid=\"9\">\n      \n      <h1 id=\"nm-headline\" class=\"nm-mono font-bold text-[#FFFFFF] uppercase mb-4 w-full\" style=\"font-size:clamp(1.75rem,7vw,7rem);line-height:1.0;letter-spacing:-0.02em;overflow-wrap:anywhere;clip-path:inset(0 0 100% 0);\" data-kid=\"10\">THE HUMAN IN THE LOOP.</h1>\n\n      \n      <p id=\"nm-tag1\" class=\"nm-mono uppercase mb-2\" style=\"font-size:clamp(0.9rem,1.5vw,1.125rem);color:#888888;letter-spacing:0.12em;opacity:0;\" data-kid=\"11\">\n        <span data-kid=\"12\">AI automates the code.</span>\n        <span class=\"font-bold\" style=\"color:#CCFF00;\" data-kid=\"13\">The human dictates the strategy.</span>\n      </p>\n      <p id=\"nm-tag2\" class=\"nm-mono uppercase mb-10\" style=\"font-size:13px;color:#777777;letter-spacing:0.12em;opacity:0;\" data-kid=\"14\">\n        Multiplatform and high-reliability backend systems developer.\n      </p>\n\n      \n      <div id=\"nm-ctas\" class=\"flex gap-4 flex-wrap\" style=\"opacity:0;\" data-kid=\"15\">\n        <button class=\"nm-mono uppercase font-medium px-6 py-3 border bg-[#CCFF00] text-[#000000] border-[#CCFF00] hover:bg-transparent hover:text-[#CCFF00] cursor-pointer\" style=\"border-radius:0;letter-spacing:0.08em;font-size:13px;transition:background-color .25s ease,color .25s ease;\" data-kid=\"16\">[ VER SISTEMAS ]</button>\n        <button class=\"nm-mono uppercase font-medium px-6 py-3 border bg-transparent text-[#FFFFFF] border-[#222222] hover:border-[#CCFF00] hover:text-[#CCFF00] cursor-pointer\" style=\"border-radius:0;letter-spacing:0.08em;font-size:13px;transition:border-color .25s ease,color .25s ease;\" data-kid=\"17\">[ CONTACTO ]</button>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"relative z-10 max-w-6xl mx-auto w-full\" data-kid=\"18\">\n    <div class=\"nm-mono inline-flex items-center gap-2 uppercase\" style=\"font-size:11px;color:#444444;letter-spacing:0.1em;\" data-kid=\"19\">\n      <span class=\"inline-block w-1.5 h-1.5 rounded-full\" style=\"background:#CCFF00;box-shadow:0 0 8px #CCFF00;\" data-kid=\"20\"></span>\n      <span data-kid=\"21\">SYSTEM ONLINE — HUMAN_IN_THE_LOOP.EXE</span>\n    </div>\n  </div>\n</section>\n\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js\" data-kid=\"22\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"23\"></script>\n<script data-kid=\"24\">\n(function () {\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var section = document.getElementById('nm-hero');\n  var canvas = document.getElementById('nm-canvas');\n\n  /* ---------- THREE.JS NEURAL MESH ---------- */\n  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n  var scene = new THREE.Scene();\n  var camera = new THREE.PerspectiveCamera(60, 1, 0.1, 1000);\n  camera.position.z = 30;\n\n  var group = new THREE.Group();\n  scene.add(group);\n\n  // Generate nodes in a rough sphere cloud\n  var NODE_COUNT = 150;\n  var RADIUS = 14;\n  var nodes = [];\n  for (var i = 0; i < NODE_COUNT; i++) {\n    var u = Math.random(), v = Math.random();\n    var theta = 2 * Math.PI * u;\n    var phi = Math.acos(2 * v - 1);\n    var r = RADIUS * Math.cbrt(Math.random()) * 0.85 + RADIUS * 0.15;\n    var x = r * Math.sin(phi) * Math.cos(theta);\n    var y = r * Math.sin(phi) * Math.sin(theta);\n    var z = r * Math.cos(phi);\n    nodes.push({\n      base: new THREE.Vector3(x, y, z),\n      pos: new THREE.Vector3(x, y, z),\n      phase: Math.random() * Math.PI * 2,\n      amp: 0.3 + Math.random() * 0.6\n    });\n  }\n  // central \"human\" node\n  var center = { base: new THREE.Vector3(0,0,0), pos: new THREE.Vector3(0,0,0), phase:0, amp:0 };\n\n  /* --- regular point cloud --- */\n  var ptGeo = new THREE.BufferGeometry();\n  var ptPos = new Float32Array(NODE_COUNT * 3);\n  ptGeo.setAttribute('position', new THREE.BufferAttribute(ptPos, 3));\n  var ptMat = new THREE.PointsMaterial({\n    color: 0xffffff, size: 0.5, transparent: true, opacity: 0.85,\n    blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true\n  });\n  var points = new THREE.Points(ptGeo, ptMat);\n  group.add(points);\n\n  /* --- central glowing node --- */\n  var centerGeo = new THREE.BufferGeometry();\n  centerGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array([0,0,0]), 3));\n  var centerMat = new THREE.PointsMaterial({\n    color: 0xCCFF00, size: 2.6, transparent: true, opacity: 1,\n    blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true\n  });\n  var centerPoint = new THREE.Points(centerGeo, centerMat);\n  group.add(centerPoint);\n\n  // glow halo sprite around center\n  function makeGlow() {\n    var c = document.createElement('canvas'); c.width = c.height = 128;\n    var ctx = c.getContext('2d');\n    var g = ctx.createRadialGradient(64,64,0,64,64,64);\n    g.addColorStop(0,'rgba(204,255,0,0.9)');\n    g.addColorStop(0.25,'rgba(204,255,0,0.35)');\n    g.addColorStop(1,'rgba(204,255,0,0)');\n    ctx.fillStyle = g; ctx.fillRect(0,0,128,128);\n    return new THREE.CanvasTexture(c);\n  }\n  var glowMat = new THREE.SpriteMaterial({ map: makeGlow(), transparent: true, blending: THREE.AdditiveBlending, depthWrite: false });\n  var glow = new THREE.Sprite(glowMat);\n  glow.scale.set(9,9,1);\n  group.add(glow);\n\n  /* --- connecting lines (mesh + radiating from center) --- */\n  // Precompute neighbor pairs among nodes\n  var MESH_DIST = 6.5;\n  var meshPairs = [];\n  for (var a = 0; a < NODE_COUNT; a++) {\n    for (var b = a + 1; b < NODE_COUNT; b++) {\n      if (nodes[a].base.distanceTo(nodes[b].base) < MESH_DIST) meshPairs.push([a, b]);\n    }\n  }\n  var meshGeo = new THREE.BufferGeometry();\n  var meshPos = new Float32Array(meshPairs.length * 6);\n  meshGeo.setAttribute('position', new THREE.BufferAttribute(meshPos, 3));\n  var meshMat = new THREE.LineBasicMaterial({\n    color: 0xCCFF00, transparent: true, opacity: 0.10,\n    blending: THREE.AdditiveBlending, depthWrite: false\n  });\n  var meshLines = new THREE.LineSegments(meshGeo, meshMat);\n  group.add(meshLines);\n\n  // Radiating links from center to nearest N nodes\n  var radIdx = nodes\n    .map(function (n, idx) { return { idx: idx, d: n.base.length() }; })\n    .sort(function (p, q) { return p.d - q.d; })\n    .slice(0, 26)\n    .map(function (o) { return o.idx; });\n  var radGeo = new THREE.BufferGeometry();\n  var radPos = new Float32Array(radIdx.length * 6);\n  radGeo.setAttribute('position', new THREE.BufferAttribute(radPos, 3));\n  var radMat = new THREE.LineBasicMaterial({\n    color: 0xCCFF00, transparent: true, opacity: 0.22,\n    blending: THREE.AdditiveBlending, depthWrite: false\n  });\n  var radLines = new THREE.LineSegments(radGeo, radMat);\n  group.add(radLines);\n\n  /* --- sizing --- */\n  function resize() {\n    var w = section.clientWidth, h = section.clientHeight;\n    renderer.setSize(w, h, false);\n    camera.aspect = w / h;\n    camera.updateProjectionMatrix();\n  }\n  resize();\n  window.addEventListener('resize', resize);\n\n  /* --- mouse parallax --- */\n  var targetRX = 0, targetRY = 0, curRX = 0, curRY = 0;\n  section.addEventListener('mousemove', function (e) {\n    var rect = section.getBoundingClientRect();\n    var nx = (e.clientX - rect.left) / rect.width - 0.5;\n    var ny = (e.clientY - rect.top) / rect.height - 0.5;\n    targetRY = nx * 0.6;\n    targetRX = ny * 0.6;\n  });\n  section.addEventListener('mouseleave', function () { targetRX = 0; targetRY = 0; });\n\n  var t0 = performance.now();\n  function update(now) {\n    var t = (now - t0) / 1000;\n    // node float\n    for (var i = 0; i < NODE_COUNT; i++) {\n      var n = nodes[i];\n      var off = Math.sin(t * 0.6 + n.phase) * n.amp;\n      n.pos.copy(n.base).multiplyScalar(1 + off * 0.03);\n      ptPos[i*3] = n.pos.x; ptPos[i*3+1] = n.pos.y; ptPos[i*3+2] = n.pos.z;\n    }\n    ptGeo.attributes.position.needsUpdate = true;\n\n    // mesh lines\n    for (var m = 0; m < meshPairs.length; m++) {\n      var pa = nodes[meshPairs[m][0]].pos, pb = nodes[meshPairs[m][1]].pos;\n      var o = m * 6;\n      meshPos[o]=pa.x; meshPos[o+1]=pa.y; meshPos[o+2]=pa.z;\n      meshPos[o+3]=pb.x; meshPos[o+4]=pb.y; meshPos[o+5]=pb.z;\n    }\n    meshGeo.attributes.position.needsUpdate = true;\n\n    // radiating lines + signal pulse\n    for (var rI = 0; rI < radIdx.length; rI++) {\n      var pe = nodes[radIdx[rI]].pos;\n      var ro = rI * 6;\n      radPos[ro]=0; radPos[ro+1]=0; radPos[ro+2]=0;\n      radPos[ro+3]=pe.x; radPos[ro+4]=pe.y; radPos[ro+5]=pe.z;\n    }\n    radGeo.attributes.position.needsUpdate = true;\n\n    // pulse: signal traveling outward through the loop\n    var pulse = (Math.sin(t * 1.5) * 0.5 + 0.5);\n    radMat.opacity = 0.14 + pulse * 0.30;\n    centerMat.opacity = 0.7 + pulse * 0.3;\n    var gs = 8 + pulse * 3.5;\n    glow.scale.set(gs, gs, 1);\n    glowMat.opacity = 0.55 + pulse * 0.4;\n\n    // rotation + parallax\n    curRX += (targetRX - curRX) * 0.05;\n    curRY += (targetRY - curRY) * 0.05;\n    group.rotation.y = t * 0.07 + curRY;\n    group.rotation.x = curRX;\n  }\n\n  function render() { renderer.render(scene, camera); }\n\n  if (reduce) {\n    update(performance.now());\n    render();\n  } else {\n    (function loop(now) {\n      update(now);\n      render();\n      requestAnimationFrame(loop);\n    })(performance.now());\n  }\n\n  /* ---------- GSAP ENTRANCE ---------- */\n  if (window.gsap) {\n    if (reduce) {\n      gsap.set('#nm-headline', { clipPath: 'inset(0 0 0% 0)' });\n      gsap.set(['#nm-tag1','#nm-tag2','#nm-ctas'], { opacity: 1 });\n    } else {\n      var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });\n      tl.fromTo('#nm-headline',\n        { clipPath: 'inset(0 0 100% 0)', y: 24 },\n        { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.0 }, 0.15)\n        .fromTo('#nm-tag1', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 0.7)\n        .fromTo('#nm-tag2', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 0.85)\n        .fromTo('#nm-ctas', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 1.0);\n    }\n  }\n})();\n</script>",
