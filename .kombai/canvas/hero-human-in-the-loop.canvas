      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap');\n  .hl-font-mono { font-family: 'JetBrains Mono', monospace; }\n  .hl-font-sans { font-family: 'IBM Plex Sans', system-ui, sans-serif; }\n  #hl-hero .hl-anim { opacity: 0; }\n</style>\n\n<section id=\"hl-hero\" class=\"hl-font-sans relative overflow-hidden bg-[#000000] min-h-screen w-full flex flex-col px-[clamp(4rem,8vw,8rem)] py-[clamp(4rem,8vw,8rem)]\" data-kid=\"1\">\n\n  \n  <div class=\"pointer-events-none absolute inset-0 z-0\" style=\"\n      background-image: linear-gradient(#1A1A1A 1px, transparent 1px), linear-gradient(90deg, #1A1A1A 1px, transparent 1px);\n      background-size: 60px 60px;\n      opacity: 0.2;\n      -webkit-mask-image: radial-gradient(ellipse 100% 70% at 50% 35%, #000 18%, transparent 90%);\n      mask-image: radial-gradient(ellipse 100% 70% at 50% 35%, #000 18%, transparent 90%);\" data-kid=\"2\"></div>\n\n  \n  <div class=\"pointer-events-none absolute z-0\" style=\"top:-15%; left:-8%; width:55vw; height:55vh; background: radial-gradient(ellipse at center, rgba(204,255,0,0.05) 0%, transparent 65%);\" data-kid=\"3\"></div>\n\n  \n  <canvas id=\"hl-canvas\" class=\"pointer-events-none absolute inset-0 z-0 h-full w-full\" data-kid=\"4\"></canvas>\n\n  \n  <div class=\"pointer-events-none absolute inset-0 z-[1]\" style=\"background: radial-gradient(ellipse 80% 90% at 30% 50%, #000000 25%, transparent 75%);\" data-kid=\"5\"></div>\n\n  \n  <div class=\"relative z-10 mx-auto flex w-full max-w-[1152px] flex-1 flex-col\" data-kid=\"6\">\n\n    \n    <div class=\"hl-font-mono hl-anim mb-8 flex w-full items-center gap-3 self-start text-[11px] uppercase tracking-[0.1em] text-[#444444]\" data-kid=\"7\">\n      <span data-kid=\"8\">01/04 — HERO</span>\n      <span class=\"h-px flex-1\" style=\"background: linear-gradient(90deg, #222222 0%, transparent 100%);\" data-kid=\"9\"></span>\n    </div>\n\n    <div class=\"flex max-w-[64rem] flex-1 flex-col justify-center\" data-kid=\"10\">\n\n      \n      <h1 class=\"hl-font-mono hl-anim mb-4 w-full font-bold uppercase leading-[1.0] tracking-[-0.02em] text-[#FFFFFF] text-[clamp(1.75rem,7vw,7rem)] [overflow-wrap:anywhere]\" data-kid=\"11\">\n        THE HUMAN IN THE LOOP.\n      </h1>\n\n      \n      <p class=\"hl-font-mono hl-anim mb-2 uppercase tracking-[0.12em] text-[clamp(0.9rem,1.5vw,1.125rem)] text-[#888888]\" data-kid=\"12\">\n        <span data-kid=\"13\">AI automates the code.</span>\n        <span class=\"font-bold text-[#CCFF00]\" data-kid=\"14\">The human dictates the strategy.</span>\n      </p>\n\n      \n      <p class=\"hl-font-mono hl-anim mb-10 text-[13px] uppercase tracking-[0.12em] text-[#777777]\" data-kid=\"15\">\n        Multiplatform and high-reliability backend systems developer.\n      </p>\n\n      \n      <div class=\"hl-anim flex flex-wrap gap-4\" data-kid=\"16\">\n        <button class=\"hl-font-mono group relative cursor-pointer border border-[#CCFF00] bg-[#CCFF00] px-7 py-3.5 text-[13px] font-bold uppercase tracking-[0.12em] text-[#000000] transition-colors duration-300 hover:bg-transparent hover:text-[#CCFF00] rounded-[2px]\" data-kid=\"17\">\n          [ VER SISTEMAS ]\n        </button>\n        <button class=\"hl-font-mono group relative cursor-pointer border border-[#222222] bg-transparent px-7 py-3.5 text-[13px] font-bold uppercase tracking-[0.12em] text-[#FFFFFF] transition-colors duration-300 hover:border-[#CCFF00] hover:text-[#CCFF00] rounded-[2px]\" data-kid=\"18\">\n          [ CONTACTO ]\n        </button>\n      </div>\n\n    </div>\n\n    \n    <div class=\"hl-font-mono hl-anim mt-10 flex w-full items-center justify-between text-[10px] uppercase tracking-[0.18em] text-[#444444]\" data-kid=\"19\">\n      <span data-kid=\"20\">SYS://HUMAN_AI.LOOP</span>\n      <span class=\"hidden sm:inline\" data-kid=\"21\">FEEDBACK · ITERATE · SHIP</span>\n      <span data-kid=\"22\">EST. 2026</span>\n    </div>\n\n  </div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js\" data-kid=\"23\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"24\"></script>\n  <script data-kid=\"25\">\n    (function () {\n      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n      /* ---------- GSAP entrance ---------- */\n      function runEntrance() {\n        var els = document.querySelectorAll('#hl-hero .hl-anim');\n        if (!window.gsap) { els.forEach(function (e) { e.style.opacity = 1; }); return; }\n        if (reduced) { gsap.set(els, { opacity: 1 }); return; }\n        gsap.to(els, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.12, startAt: { y: 28 } });\n      }\n      runEntrance();\n\n      /* ---------- three.js Mobius infinite loop ---------- */\n      if (!window.THREE) return;\n      var canvas = document.getElementById('hl-canvas');\n      var section = document.getElementById('hl-hero');\n      var renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });\n      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n      var scene = new THREE.Scene();\n      var camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);\n      camera.position.set(0, 0, 9);\n\n      var group = new THREE.Group();\n      scene.add(group);\n\n      var LIME = 0xCCFF00;\n\n      /* Parametric figure-eight / mobius-like loop curve */\n      function loopPoint(t, target) {\n        var a = t * Math.PI * 2;\n        var x = Math.sin(a) * 3.1;\n        var y = Math.sin(a * 2) * 1.5;\n        var z = Math.cos(a) * 1.6;\n        target.set(x, y, z);\n        return target;\n      }\n\n      var Curve = THREE.Curve ? function () {} : null;\n      var LoopCurve = function () { THREE.Curve.call(this); };\n      LoopCurve.prototype = Object.create(THREE.Curve.prototype);\n      LoopCurve.prototype.constructor = LoopCurve;\n      LoopCurve.prototype.getPoint = function (t, optionalTarget) {\n        var p = optionalTarget || new THREE.Vector3();\n        return loopPoint(t, p);\n      };\n      var curve = new LoopCurve();\n\n      /* Ribbon tube — thin elegant band with lime emissive edges */\n      var tubeGeo = new THREE.TubeGeometry(curve, 360, 0.045, 12, true);\n      var tubeMat = new THREE.MeshBasicMaterial({ color: LIME, transparent: true, opacity: 0.55 });\n      var tube = new THREE.Mesh(tubeGeo, tubeMat);\n      group.add(tube);\n\n      /* Wireframe glow layer over the ribbon */\n      var wireGeo = new THREE.TubeGeometry(curve, 200, 0.09, 8, true);\n      var wireMat = new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.12, blending: THREE.AdditiveBlending });\n      var wire = new THREE.Mesh(wireGeo, wireMat);\n      group.add(wire);\n\n      /* Faint background wireframe torus-knot for depth */\n      var knotGeo = new THREE.TorusKnotGeometry(2.6, 0.55, 90, 12, 2, 3);\n      var knotMat = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true, transparent: true, opacity: 0.04 });\n      var knot = new THREE.Mesh(knotGeo, knotMat);\n      knot.scale.set(1.4, 1.4, 1.4);\n      group.add(knot);\n\n      /* Particles travelling ALONG the loop — circulating feedback/data */\n      var COUNT = 120;\n      var offsets = new Float32Array(COUNT);\n      var posArr = new Float32Array(COUNT * 3);\n      for (var i = 0; i < COUNT; i++) { offsets[i] = i / COUNT; }\n      var pGeo = new THREE.BufferGeometry();\n      pGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));\n      var pMat = new THREE.PointsMaterial({ color: LIME, size: 0.11, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending, depthWrite: false });\n      var particles = new THREE.Points(pGeo, pMat);\n      group.add(particles);\n\n      /* A few brighter white \"human decision\" nodes orbiting slower */\n      var COUNT2 = 26;\n      var off2 = new Float32Array(COUNT2);\n      var pos2 = new Float32Array(COUNT2 * 3);\n      for (var j = 0; j < COUNT2; j++) { off2[j] = j / COUNT2; }\n      var p2Geo = new THREE.BufferGeometry();\n      p2Geo.setAttribute('position', new THREE.BufferAttribute(pos2, 3));\n      var p2Mat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.16, transparent: true, opacity: 0.7, blending: THREE.AdditiveBlending, depthWrite: false });\n      var particles2 = new THREE.Points(p2Geo, p2Mat);\n      group.add(particles2);\n\n      var tmp = new THREE.Vector3();\n      function updateParticles(t, attr, offs, n, dir) {\n        for (var k = 0; k < n; k++) {\n          var tt = (offs[k] + t * dir) % 1;\n          if (tt < 0) tt += 1;\n          loopPoint(tt, tmp);\n          attr.array[k * 3] = tmp.x;\n          attr.array[k * 3 + 1] = tmp.y;\n          attr.array[k * 3 + 2] = tmp.z;\n        }\n        attr.needsUpdate = true;\n      }\n\n      /* Mouse parallax */\n      var mx = 0, my = 0, tmx = 0, tmy = 0;\n      section.addEventListener('mousemove', function (e) {\n        var r = section.getBoundingClientRect();\n        tmx = ((e.clientX - r.left) / r.width - 0.5) * 2;\n        tmy = ((e.clientY - r.top) / r.height - 0.5) * 2;\n      });\n\n      function resize() {\n        var w = section.clientWidth, h = section.clientHeight;\n        renderer.setSize(w, h, false);\n        camera.aspect = w / h;\n        camera.updateProjectionMatrix();\n      }\n      window.addEventListener('resize', resize);\n      resize();\n\n      var start = performance.now();\n      function render() {\n        var elapsed = (performance.now() - start) / 1000;\n\n        if (!reduced) {\n          group.rotation.y = elapsed * 0.12;\n          group.rotation.z = Math.sin(elapsed * 0.18) * 0.12;\n          knot.rotation.x = elapsed * 0.06;\n          knot.rotation.y = -elapsed * 0.04;\n\n          mx += (tmx - mx) * 0.05;\n          my += (tmy - my) * 0.05;\n          group.rotation.x = my * 0.25;\n          camera.position.x = mx * 0.8;\n          camera.lookAt(0, 0, 0);\n\n          updateParticles(elapsed * 0.06, pGeo.attributes.position, offsets, COUNT, 1);\n          updateParticles(elapsed * 0.025, p2Geo.attributes.position, off2, COUNT2, -1);\n        } else {\n          updateParticles(0.2, pGeo.attributes.position, offsets, COUNT, 1);\n          updateParticles(0.5, p2Geo.attributes.position, off2, COUNT2, -1);\n        }\n\n        renderer.render(scene, camera);\n        if (!reduced) requestAnimationFrame(render);\n      }\n      render();\n    })();\n  </script>\n\n</section>",
